{
  "csv-integrity-guard": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python .agents/hooks/verify_csv_integrity.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
